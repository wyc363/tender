# OpenAI-compatible API configuration. Copy this file to .env and fill locally.
MODEL_API_BASE=https://example.com/v1
MODEL_API_KEY=replace_me
MODEL_NAME=your-model-name
MODEL_TEMPERATURE=0
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=2
MODEL_MAX_TOKENS=4096
# auto uses streaming for ModelScope; set true for another stream-only endpoint.
MODEL_FORCE_STREAM=auto
MODEL_ENABLE_THINKING=false

# V0.3 MIPROv2: use automatic budget (light/medium/heavy).
V03_MIPRO_AUTO=light
# To use an explicit trial count, set V03_MIPRO_AUTO=none and uncomment:
# V03_MIPRO_NUM_TRIALS=20
# Optional candidate count for explicit-budget mode:
# V03_MIPRO_NUM_CANDIDATES=10
V03_MIPRO_SEED=42
V03_MIPRO_NUM_THREADS=1
V03_MIPRO_MAX_ERRORS=20

# Optional path overrides. Defaults already point to the parent experiment directory.
RULES_FILE=D:/path/to/rules.xlsx
REVIEWS_FILE=D:/path/to/expert_reviews.xlsx
OUTPUT_DIR=D:/path/to/outputs/v01
