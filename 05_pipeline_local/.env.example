# Copy this file to .env. Never commit the copied file.
# Paths may be absolute on one machine; business code and YAML stay unchanged.
TENDER_REVIEW_PROJECT_ROOT=../..
TENDER_REVIEW_OUTPUT_ROOT=../outputs/tender_review_system
TENDER_REVIEW_TEMP_ROOT=../outputs/tender_review_system/.tmp
TENDER_REVIEW_STAGING_ROOT=../outputs/tender_review_system/.staging
TENDER_REVIEW_JOB_DB=

# Leave blank to use the Python process that starts the pipeline. Set a separate
# executable when Docling or another stage has its own environment.
TENDER_REVIEW_DOCLING_PYTHON=
TENDER_REVIEW_PARSER_PYTHON=
TENDER_REVIEW_CHUNK_PYTHON=
TENDER_REVIEW_RETRIEVAL_PYTHON=
TENDER_REVIEW_JUDGE_PYTHON=
TENDER_REVIEW_PARSER_ENV_FILE=05_pipeline_local/.env
TENDER_REVIEW_JUDGE_ENV_FILE=05_pipeline_local/.env

# Parser VLM settings
PARSER_VLM_API_BASE=https://your-parser-endpoint/compatible-mode/v1
PARSER_VLM_API_KEY=
PARSER_VLM_MODEL=qwen3.7-flash
PARSER_VLM_TEMPERATURE=0
PARSER_VLM_MAX_TOKENS=2500
PARSER_VLM_ENABLE_THINKING=false
PARSER_VLM_TIMEOUT_SECONDS=120
PARSER_VLM_MAX_RETRIES=1
PARSER_VLM_MAX_PIXELS=1572864
PARSER_VLM_CONCURRENCY=1

# Judge settings
MODEL_API_BASE=https://your-judge-endpoint/compatible-mode/v1
MODEL_API_KEY=
MODEL_NAME=qwen3-8b
MODEL_TEMPERATURE=0
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
MODEL_RETRY_BACKOFF_SECONDS=2
MODEL_FORCE_STREAM=auto
MODEL_ENABLE_THINKING=false
