# Copy to tender_review_system/05_pipeline_local/.env and chmod 600.
# Never commit or print the real values.
PARSER_VLM_API_BASE=
PARSER_VLM_API_KEY=
PARSER_VLM_MODEL=qwen3.7-flash

MODEL_API_BASE=
MODEL_API_KEY=
